# ========================================================
# Skill Swap Platform - Server Configuration Environment
# ========================================================

# Server Port
PORT=5000

# Application Environment (development | production | test)
NODE_ENV=production

# JWT Secret Key for token signing (Must be a long, random string in production)
JWT_SECRET=production-skill-swap-secret-key-change-in-real-deployment-2026

# Allowed CORS Origins (comma-separated for multiple origins, or * for open access)
CORS_ORIGIN=*

# Rate Limiting Configuration
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=150

# Database Configuration
# Default is zero-config SQLite stored in server/data/skillswap.sqlite
# To use PostgreSQL, uncomment below and set DATABASE_URL:
# DB_DIALECT=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/skillswap
# DB_SSL=false
